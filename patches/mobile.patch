+using Robust.Shared.Map;
+using Robust.Shared.Maths;
+
+
+namespace Robust.Client.UserInterface.Mobile;
+
+public sealed partial class MobileControlsOverlay : Control
+{
+    [Dependency] private readonly IConfigurationManager _cfg = default!;
+    [Dependency] private readonly IUserInterfaceManagerInternal _uiMgr = default!;
+    [Dependency] private readonly IClyde _clyde = default!;
+
+
+    public static bool IsEditMode { get; private set; }
+
+    private readonly VirtualThumbstick _thumbstick;
+    public static bool IsSecondaryActive { get; set; }
+    private static PojavActionButton? _staticSecButton;
+
+    public static void ResetSecondaryMode()
+    {
+        IsSecondaryActive = false;
+        if (_staticSecButton != null)
+        {
+            _staticSecButton.ResetToggle();
+        }
+    }
+
+    public static bool IsExamActive { get; set; }
+    private static PojavActionButton? _staticExamButton;
+
+    public static void ResetExamMode()
+    {
+        IsExamActive = false;
+        if (_staticExamButton != null && _staticExamButton.IsToggled)
+        {
+            _staticExamButton.ResetToggle();
+        }
+        else if (IoCManager.Resolve<IInputManager>().IsKeyDown(Keyboard.Key.Shift))
+        {
+            IoCManager.Resolve<IInputManager>().KeyUp(new KeyEventArgs(Keyboard.Key.Shift, false, false, false, false, false, 0));
+        }
+    }
+
+    public static bool IsPullActive { get; set; }
+    private static PojavActionButton? _staticPullButton;
+
+    public static void ResetPullMode()
+    {
+        IsPullActive = false;
+        if (_staticPullButton != null && _staticPullButton.IsToggled)
+        {
+            _staticPullButton.ResetToggle();
+        }
+        else if (IoCManager.Resolve<IInputManager>().IsKeyDown(Keyboard.Key.Control))
+        {
+            IoCManager.Resolve<IInputManager>().KeyUp(new KeyEventArgs(Keyboard.Key.Control, false, false, false, false, false, 0));
+        }
+    }
+
+    private readonly PojavActionButton _pullButton;
+    private readonly PojavActionButton _examButton;
+
+    private readonly PojavActionButton _useButton;
+    private readonly PojavActionButton _interactButton;
+    private readonly PojavActionButton _secButton;
+    private readonly PojavActionButton _handButton;
+    private readonly PojavActionButton _dropButton;
+    private readonly PojavActionButton _altButton;
+    private readonly PojavActionButton _bagButton;
+    private readonly PojavActionButton _throwButton;
+
+    private readonly Dictionary<long, Control> _claimedTouches = new();
+
+
+
+    private readonly PojavActionButton _escButton;
+    private readonly PojavActionButton _keybButton;
+    private readonly PojavActionButton _editButton;
+    private readonly PojavActionButton _hideButton;
+
+    private readonly Control _clusterContainer;
+    private readonly Control _topUtilityContainer;
+    private readonly Control _editorBarContainer;
+    private readonly Label _editorBanner;
+    private readonly Button _addBtn;
+    private readonly Button _scaleMinusBtn;
+    private readonly Button _scalePlusBtn;
+    private readonly Button _resetBtn;
+    private readonly Button _doneBtn;
+
