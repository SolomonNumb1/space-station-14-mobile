+    private void LoadSavedLayout()
+    {
+        var serialized = _cfg.GetCVar(CVars.MobileControlsLayout);
+        if (string.IsNullOrWhiteSpace(serialized))
+            return;
+
+        var entries = serialized.Split(';', StringSplitOptions.RemoveEmptyEntries);
+        foreach (var entry in entries)
+        {
+            var parts = entry.Split(':');
+            if (parts.Length < 2) continue;
+
+            if (parts[0] == "stick" && parts.Length >= 2)
+            {
+                var coords = parts[1].Split(',');
+                if (coords.Length == 2 &&
+                    float.TryParse(coords[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var sx) &&
+                    float.TryParse(coords[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var sy))
+                {
+                    _thumbstick.CustomPosition = new Vector2(sx, sy);
+                }
+                continue;
+            }
+
+            if (parts[0] == "del" && parts.Length >= 2)
+            {
+                var delId = parts[1];
+                if (delId != "edit" && delId != "hide" && delId != "esc" && delId != "keyb")
+                {
+                    _deletedButtonIds.Add(delId);
+                }
+                continue;
+            }
+
+            if (parts[0] == "custom" && parts.Length >= 5)
+            {
+                var id = parts[1];
+                var text = parts[2];
+                Keyboard.Key? key = Enum.TryParse<Keyboard.Key>(parts[3], true, out var parsedKey) ? parsedKey : null;
+                var coords = parts[4].Split(',');
+                if (coords.Length == 2 &&
+                    float.TryParse(coords[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var cx) &&
+                    float.TryParse(coords[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var cy))
+                {
+                    float? cSize = null;
+                    if (parts.Length >= 6 && float.TryParse(parts[5], NumberStyles.Float, CultureInfo.InvariantCulture, out var ps))
+                    {
+                        cSize = ps;
+                    }
+                    var customBtn = CreateButton(text, key, PojavSpecialAction.None, id, isCustom: true);
+                    customBtn.CustomPosition = new Vector2(cx, cy);
+                    customBtn.CustomSize = cSize;
+                }
+                continue;
+            }
+
+            if (parts[0] == "btn" && parts.Length >= 5)
+            {
+                var id = parts[1];
+                var text = parts[2];
+                Keyboard.Key? key = Enum.TryParse<Keyboard.Key>(parts[3], true, out var parsedKey) ? parsedKey : null;
+                var coords = parts[4].Split(',');
+                float? cSize = null;
+                if (parts.Length >= 6 && float.TryParse(parts[5], NumberStyles.Float, CultureInfo.InvariantCulture, out var ps))
+                {
+                    cSize = ps;
+                }
+
+                var existing = _allButtons.Find(b => b.Id == id);
+                if (existing != null)
+                {
+                    if (!string.IsNullOrWhiteSpace(text)) existing.Text = text;
+                    if (key.HasValue) existing.ActionKey = key.Value;
+                    if (coords.Length == 2 &&
+                        float.TryParse(coords[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var bx) &&
+                        float.TryParse(coords[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var by))
+                    {
+                        existing.CustomPosition = new Vector2(bx, by);
+                    }
+                    if (cSize.HasValue) existing.CustomSize = cSize;
+                }
+                continue;
+            }
+
+            var btnId = parts[0];
+            var bCoords = parts[1].Split(',');
+            if (bCoords.Length == 2 &&
+                float.TryParse(bCoords[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var obx) &&
+                float.TryParse(bCoords[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var oby))
+            {
+                _savedPositions[btnId] = new Vector2(obx, oby);
+                if (parts.Length >= 3 && float.TryParse(parts[2], NumberStyles.Float, CultureInfo.InvariantCulture, out var bs))
+                {
+                    _savedSizes[btnId] = bs;
+                }
+            }
+        }
+
+        _deletedButtonIds.Remove("edit");
+        _deletedButtonIds.Remove("hide");
+        _deletedButtonIds.Remove("esc");
+        _deletedButtonIds.Remove("keyb");
+
+        for (int i = _allButtons.Count - 1; i >= 0; i--)
+        {
+            var btn = _allButtons[i];
+            if (_deletedButtonIds.Contains(btn.Id))
+            {
+                _allButtons.RemoveAt(i);
+                _clusterContainer.RemoveChild(btn);
+            }
+        }
+
+        foreach (var btn in _allButtons)
+        {
+            if (_savedPositions.TryGetValue(btn.Id, out var pos))
+                btn.CustomPosition = pos;
+            if (_savedSizes.TryGetValue(btn.Id, out var size))
+                btn.CustomSize = size;
+        }
+    }
+
+    private void SaveLayout()
+    {
+        var parts = new List<string>();
+
+        if (_thumbstick.CustomPosition.HasValue)
+        {
+            var p = _thumbstick.CustomPosition.Value;
+            parts.Add($"stick:{p.X.ToString("F1", CultureInfo.InvariantCulture)},{p.Y.ToString("F1", CultureInfo.InvariantCulture)}");
+        }
+
+        foreach (var delId in _deletedButtonIds)
+        {
+            if (delId == "edit" || delId == "hide" || delId == "esc" || delId == "keyb")
+                continue;
+            parts.Add($"del:{delId}");
+        }
+
+        foreach (var btn in _allButtons)
+        {
+            if (btn == _editButton || btn == _hideButton || btn == _escButton || btn == _keybButton)
+                continue;
+
+            var posX = btn.CustomPosition?.X ?? btn.DefaultPosition.X;
+            var posY = btn.CustomPosition?.Y ?? btn.DefaultPosition.Y;
+            var sizeStr = btn.CustomSize.HasValue ? $":{btn.CustomSize.Value.ToString("F0", CultureInfo.InvariantCulture)}" : "";
+
+            if (btn.IsCustom)
+            {
+                var keyStr = btn.ActionKey?.ToString() ?? "None";
+                parts.Add($"custom:{btn.Id}:{btn.Text}:{keyStr}:{posX.ToString("F1", CultureInfo.InvariantCulture)},{posY.ToString("F1", CultureInfo.InvariantCulture)}{sizeStr}");
+            }
+            else
+            {
+                var keyStr = btn.ActionKey?.ToString() ?? (btn.SpecialAction != PojavSpecialAction.None ? btn.SpecialAction.ToString() : "None");
+                parts.Add($"btn:{btn.Id}:{btn.Text}:{keyStr}:{posX.ToString("F1", CultureInfo.InvariantCulture)},{posY.ToString("F1", CultureInfo.InvariantCulture)}{sizeStr}");
+            }
+        }
+
+        var serialized = string.Join(";", parts);
+        _cfg.SetCVar(CVars.MobileControlsLayout, serialized);
+        DumpMobileDebugInfo();
+    }
+
+    private void DumpArrangeDebugInfo(Vector2 viewport, float scale)
+    {
+        try
+        {
+            var dir = ProgramShared.PathOffset;
+            if (string.IsNullOrEmpty(dir))
+                return;
+            var sb = new System.Text.StringBuilder();
+            sb.AppendLine($"utc={DateTime.UtcNow:O}");
+            sb.AppendLine($"viewport={viewport} controls_scale={scale.ToString(CultureInfo.InvariantCulture)}");
+            sb.AppendLine($"stick pos={_thumbstick.GlobalPosition} size={_thumbstick.Size} custom={_thumbstick.CustomPosition?.ToString() ?? "<none>"}");
+            foreach (var b in _allButtons)
+            {
+                sb.AppendLine($"btn {b.Id} pos={b.GlobalPosition} size={b.Size} custom={b.CustomPosition?.ToString() ?? "<none>"} label=\"{b.Text}\" edit={b.IsEditMode}");
+            }
+            File.WriteAllText(Path.Combine(dir, "mobile-arrange-debug.txt"), sb.ToString());
+        }
+        catch { }
+    }
+
+    /// <summary>
+    /// Writes current touch-control state where the launcher crash reporter
+    /// can pick it up (separate process, same files dir). Proves the overlay
+    /// constructed and shows exact positions/scales.
+    /// </summary>
+    private void DumpMobileDebugInfo()
+    {
+        try
+        {
+            var dir = ProgramShared.PathOffset;
+            if (string.IsNullOrEmpty(dir))
+                return;
+            var sb = new System.Text.StringBuilder();
+            sb.AppendLine($"utc={DateTime.UtcNow:O}");
+            sb.AppendLine($"overlay_constructed=true");
+            sb.AppendLine($"mobile.touch_controls={_cfg.GetCVar(CVars.MobileTouchControls)}");
+            sb.AppendLine($"mobile.controls_scale={_cfg.GetCVar(CVars.MobileControlsScale).ToString(CultureInfo.InvariantCulture)}");
+            sb.AppendLine($"mobile.controls_opacity={_cfg.GetCVar(CVars.MobileControlsOpacity).ToString(CultureInfo.InvariantCulture)}");
+            sb.AppendLine($"mobile.controls_layout={_cfg.GetCVar(CVars.MobileControlsLayout)}");
+            sb.AppendLine($"display.uiScale={_cfg.GetCVar(CVars.DisplayUIScale).ToString(CultureInfo.InvariantCulture)}");
+            sb.AppendLine($"stick_default={_thumbstick.DefaultPosition} stick_custom={_thumbstick.CustomPosition?.ToString() ?? "<none>"}");
+            sb.AppendLine($"stick_size={_thumbstick.Size} overlay_size={Size} overlay_visible={Visible}");
+            File.WriteAllText(Path.Combine(dir, "mobile-controls-debug.txt"), sb.ToString());
+        }
+        catch { }
+    }
+
+    private void ArrangeChild(Control control, Vector2 defaultPos, Vector2 defaultSize, Vector2 viewport)
+    {
+        Vector2 pos;
+        Vector2 size = defaultSize;
+
+        if (control is PojavActionButton btn)
+        {
+            btn.DefaultPosition = defaultPos;
+            if (btn.CustomPosition.HasValue)
+            {
+                var cp = btn.CustomPosition.Value;
+                if (cp.X < -50f || cp.Y < -50f || cp.X > 4000f || cp.Y > 4000f)
+                {
+                    btn.CustomPosition = null;
+                }
+            }
+            pos = btn.CustomPosition ?? defaultPos;
+            if (btn.CustomSize.HasValue)
+            {
+                var s = btn.CustomSize.Value;
+                size = new Vector2(s, s);
+            }
+        }
+        else if (control is VirtualThumbstick stick)
+        {
+            stick.DefaultPosition = defaultPos;
+            if (stick.CustomPosition.HasValue)
+            {
+                var cp = stick.CustomPosition.Value;
+                if (cp.X < -50f || cp.Y < -50f || cp.X > 4000f || cp.Y > 4000f)
+                {
+                    stick.CustomPosition = null;
+                }
+            }
+            pos = stick.CustomPosition ?? defaultPos;
+        }
+        else
+        {
+            pos = defaultPos;
+        }
+
+        // Mobile: never arrange off-screen (stale saved coords from another
+        // orientation, or a foreign layout format, used to lose controls).
+        var maxPos = viewport - size;
+        if (maxPos.X < 0f) maxPos.X = 0f;
+        if (maxPos.Y < 0f) maxPos.Y = 0f;
+        pos = new Vector2(Math.Clamp(pos.X, 0f, maxPos.X), Math.Clamp(pos.Y, 0f, maxPos.Y));
+
+        control.Arrange(new UIBox2(pos, pos + size));
+    }
+
+    protected override Vector2 ArrangeOverride(Vector2 finalSize)
+    {
+        _clusterContainer.Arrange(new UIBox2(Vector2.Zero, finalSize));
+        _topUtilityContainer.Arrange(new UIBox2(Vector2.Zero, finalSize));
+
+        var scale = Math.Clamp(_cfg.GetCVar(CVars.MobileControlsScale), 0.6f, 3.0f);
+        var stickScale = Math.Clamp(_cfg.GetCVar(CVars.MobileThumbstickScale), 0.5f, 2.0f);
+
+        var stickRadius = 75f * scale * stickScale;
+        var stickDiameter = stickRadius * 2f;
+        var stickMarginX = 35f * scale;
+
+        _thumbstick.Radius = stickRadius;
+        _thumbstick.KnobRadius = 32f * scale * stickScale;
+        _thumbstick.Deadzone = 10f * scale * stickScale;
+
+        var stickCenterY = finalSize.Y * 0.66f;
+        var defaultStickY = stickCenterY - stickRadius;
+        var defaultStickPos = new Vector2(stickMarginX, defaultStickY);
+        var stickSize = new Vector2(stickDiameter + 20f, stickDiameter + 20f);
+        ArrangeChild(_thumbstick, defaultStickPos, stickSize, finalSize);
+
+        var useSize = 54f * scale;
+        var useDefPos = new Vector2(finalSize.X - useSize - 24f * scale, finalSize.Y * 0.54f);
+        ArrangeChild(_useButton, useDefPos, new Vector2(useSize, useSize), finalSize);
+
+        var interSize = 48f * scale;
+        var interDefPos = new Vector2(useDefPos.X - interSize - 16f * scale, useDefPos.Y + 14f * scale);
+        ArrangeChild(_interactButton, interDefPos, new Vector2(interSize, interSize), finalSize);
+
+        var secSize = 46f * scale;
+        var secDefPos = new Vector2(interDefPos.X - secSize - 14f * scale, interDefPos.Y + 12f * scale);
+        ArrangeChild(_secButton, secDefPos, new Vector2(secSize, secSize), finalSize);
+
+        var handSize = 44f * scale;
+        var handDefPos = new Vector2(useDefPos.X + 4f * scale, useDefPos.Y - handSize - 16f * scale);
+        ArrangeChild(_handButton, handDefPos, new Vector2(handSize, handSize), finalSize);
+
+        var dropSize = 42f * scale;
+        var dropDefPos = new Vector2(interDefPos.X - 2f * scale, interDefPos.Y - dropSize - 18f * scale);
+        ArrangeChild(_dropButton, dropDefPos, new Vector2(dropSize, dropSize), finalSize);
+
+        var altSize = 42f * scale;
+        var altDefPos = new Vector2(secDefPos.X, secDefPos.Y - altSize - 16f * scale);
+        ArrangeChild(_altButton, altDefPos, new Vector2(altSize, altSize), finalSize);
+
+        var examSize = 42f * scale;
+        var examDefPos = new Vector2(dropDefPos.X, dropDefPos.Y - examSize - 14f * scale);
+        ArrangeChild(_examButton, examDefPos, new Vector2(examSize, examSize), finalSize);
+
+        var pullSize = 42f * scale;
+        var pullDefPos = new Vector2(altDefPos.X, altDefPos.Y - pullSize - 14f * scale);
+        ArrangeChild(_pullButton, pullDefPos, new Vector2(pullSize, pullSize), finalSize);
+
+        var bagSize = 44f * scale;
+        var bagDefPos = new Vector2(handDefPos.X, handDefPos.Y - bagSize - 16f * scale);
+        ArrangeChild(_bagButton, bagDefPos, new Vector2(bagSize, bagSize), finalSize);
+
+        var throwSize = 42f * scale;
+        var throwDefPos = new Vector2(examDefPos.X, examDefPos.Y - throwSize - 14f * scale);
+        ArrangeChild(_throwButton, throwDefPos, new Vector2(throwSize, throwSize), finalSize);
+
+        foreach (var btn in _allButtons)
+        {
+            if (btn.IsCustom)
+            {
+                var defSize = new Vector2(50f * scale, 50f * scale);
+                var defPos = new Vector2(finalSize.X / 2f - 25f, finalSize.Y / 2f - 25f);
+                ArrangeChild(btn, defPos, defSize, finalSize);
+            }
+        }
+
+        var topBtnW = 46f * scale;
+        var topBtnH = 34f * scale;
+        var topY = 14f * scale;
+
+        ArrangeChild(_escButton, new Vector2(24f * scale, topY), new Vector2(topBtnW, topBtnH), finalSize);
+        ArrangeChild(_editButton, new Vector2(24f * scale + topBtnW + 12f * scale, topY), new Vector2(topBtnW + 8f * scale, topBtnH), finalSize);
+
+        var keybX = finalSize.X - topBtnW - (24f * scale);
+        ArrangeChild(_keybButton, new Vector2(keybX, topY), new Vector2(topBtnW, topBtnH), finalSize);
+
+        var hideW = 48f * scale;
+        var hideH = 28f * scale;
+        var hideX = (finalSize.X - hideW) / 2f;
+        ArrangeChild(_hideButton, new Vector2(hideX, 6f * scale), new Vector2(hideW, hideH), finalSize);
+
+        if (_editorBarContainer.Visible)
+        {
+            var barW = MathF.Min(finalSize.X - 260f * scale, 750f);
+            var barH = 50f;
+            var barX = (finalSize.X - barW) / 2f;
+            _editorBarContainer.Arrange(new UIBox2(barX, 10f, barX + barW, 10f + barH));
+        }
+
+        if (_modalOverlay.Visible)
+        {
+            _modalOverlay.Arrange(new UIBox2(Vector2.Zero, finalSize));
+            var dialogW = MathF.Min(finalSize.X - 40f, 520f);
+            var dialogH = MathF.Min(finalSize.Y - 30f, 320f);
+            var dialogX = (finalSize.X - dialogW) / 2f;
+            var dialogY = (finalSize.Y - dialogH) / 2f;
+            _dialogPanel.Arrange(new UIBox2(dialogX, dialogY, dialogX + dialogW, dialogY + dialogH));
+        }
+
+        DumpArrangeDebugInfo(finalSize, Math.Clamp(_cfg.GetCVar(CVars.MobileControlsScale), 0.6f, 3.0f));
+
+        return finalSize;
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/PojavActionButton.cs b/Robust.Client/UserInterface/Mobile/PojavActionButton.cs
new file mode 100644
index 0000000..4f00e0a
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/PojavActionButton.cs
@@ -0,0 +1,370 @@
+using System;
+using System.Numerics;
+using Robust.Client.Graphics;
+using Robust.Client.Input;
+using Robust.Client.UserInterface;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Input;
+using Robust.Shared.IoC;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+public enum PojavSpecialAction
+{
+    None,
+    Primary,
+    Secondary,
+    KeyboardToggle,
+    Throw,
+    Custom
+}
+
+public sealed partial class PojavActionButton : Control
+{
+    [Dependency] private readonly IInputManager _inputManager = default!;
+    [Dependency] private readonly IClyde _clyde = default!;
+
+    public string Id { get; set; } = string.Empty;
+    public Vector2 DefaultPosition { get; set; }
+    public Vector2? CustomPosition { get; set; }
+    public float? CustomSize { get; set; }
+    public bool IsCustom { get; set; }
+    public bool IsEditMode { get; set; }
+    public event Action? OnPositionChanged;
+    public event Action<PojavActionButton>? OnConfigureRequested;
+
+    public string Text
+    {
+        get => _label.Text ?? string.Empty;
+        set => _label.Text = value;
+    }
+
+    public Color AccentColor { get; set; } = new Color(210, 210, 210);
+    public bool IsToggle { get; set; }
+    public bool IsToggled { get; set; }
+
+    public Keyboard.Key? ActionKey { get; set; }
+    public PojavSpecialAction SpecialAction { get; set; } = PojavSpecialAction.None;
+    public Action? OnPressed { get; set; }
+    public Action? OnReleased { get; set; }
+
+    public void ResetToggle()
+    {
+        if (IsToggle && IsToggled)
+        {
+            IsToggled = false;
+            _isPressed = false;
+            ExecuteUp();
+            OnReleased?.Invoke();
+        }
+    }
+
+    private readonly Label _label;
+    private bool _isPressed;
+    private Vector2? _dragTouchOffset;
+    private Vector2 _pressStartGlobal;
+    private bool _hasDragged;
+    private static bool _keyboardActive;
+
+    public PojavActionButton(string text, Keyboard.Key? actionKey = null, PojavSpecialAction special = PojavSpecialAction.None, string id = "", bool isCustom = false)
+    {
+        IoCManager.InjectDependencies(this);
+
+        Id = string.IsNullOrEmpty(id) ? text.ToLowerInvariant() : id;
+        ActionKey = actionKey;
+        SpecialAction = special;
+        IsCustom = isCustom;
+        MouseFilter = MouseFilterMode.Stop;
+
+        _label = new Label
+        {
+            Text = text,
+            HorizontalAlignment = HAlignment.Center,
+            VerticalAlignment = VAlignment.Center,
+            FontColorOverride = Color.White,
+            MouseFilter = MouseFilterMode.Ignore
+        };
+        AddChild(_label);
+    }
+
+    protected override Vector2 ArrangeOverride(Vector2 finalSize)
+    {
+        _label.Arrange(new UIBox2(Vector2.Zero, finalSize));
+        return finalSize;
+    }
+
+    private long? _activeFingerId;
+
+    public void OnTouchDown(long fingerId)
+    {
+        if (IsEditMode)
+            return;
+
+        _activeFingerId = fingerId;
+        if (IsToggle)
+        {
+            IsToggled = !IsToggled;
+            _isPressed = IsToggled;
+            if (IsToggled)
+                ExecuteDown();
+            else
+                ExecuteUp();
+            OnPressed?.Invoke();
+            return;
+        }
+
+        _isPressed = true;
+        ExecuteDown();
+        OnPressed?.Invoke();
+    }
+
+    public void OnTouchUp(long fingerId)
+    {
+        if (IsEditMode || IsToggle)
+            return;
+
+        if (_activeFingerId == fingerId || _isPressed)
+        {
+            _activeFingerId = null;
+            if (_isPressed)
+            {
+                _isPressed = false;
+                ExecuteUp();
+                OnReleased?.Invoke();
+            }
+        }
+    }
+
+    public void Release()
+    {
+        _activeFingerId = null;
+        if (_isPressed && !IsToggle)
+        {
+            _isPressed = false;
+            ExecuteUp();
+            OnReleased?.Invoke();
+        }
+    }
+
+    protected internal override bool HasPoint(Vector2 point)
+    {
+        const float slop = 4f;
+        var size = Size;
+        return point.X >= -slop && point.X <= size.X + slop && point.Y >= -slop && point.Y <= size.Y + slop;
+    }
+
+    protected internal override void ControlFocusExited()
+    {
+        base.ControlFocusExited();
+        if (IsEditMode)
+        {
+            _dragTouchOffset = null;
+        }
+    }
+
+    protected internal override void KeyBindDown(GUIBoundKeyEventArgs args)
+    {
+        base.KeyBindDown(args);
+
+        if (args.Function != EngineKeyFunctions.UIClick)
+            return;
+
+        if (IsEditMode)
+        {
+            UserInterfaceManager.ControlFocused = this;
+            _pressStartGlobal = GlobalPosition + args.RelativePosition;
+            _dragTouchOffset = args.RelativePosition;
+            _hasDragged = false;
+            args.Handle();
+            return;
+        }
+
+        if (_activeFingerId != null)
+        {
+            args.Handle();
+            return;
+        }
+
+        if (IsToggle)
+        {
+            IsToggled = !IsToggled;
+            _isPressed = IsToggled;
+            if (IsToggled)
+                ExecuteDown();
+            else
+                ExecuteUp();
+            OnPressed?.Invoke();
+            args.Handle();
+            return;
+        }
+
+        _isPressed = true;
+        ExecuteDown();
+        OnPressed?.Invoke();
+        args.Handle();
+    }
+
+    protected internal override void MouseMove(GUIMouseMoveEventArgs args)
+    {
+        base.MouseMove(args);
+
+        if (IsEditMode && _dragTouchOffset != null)
+        {
+            var currentGlobal = GlobalPosition + args.RelativePosition;
+            var delta = currentGlobal - _pressStartGlobal;
+            if (delta.LengthSquared() > 36f)
+            {
+                _hasDragged = true;
+            }
+
+            var parentGlobal = Parent?.GlobalPosition ?? Vector2.Zero;
+            var newGlobal = currentGlobal - _dragTouchOffset.Value;
+            var newLocal = newGlobal - parentGlobal;
+            CustomPosition = newLocal;
+            Arrange(new UIBox2(newLocal, newLocal + Size));
+            OnPositionChanged?.Invoke();
+        }
+    }
+
+    protected internal override void KeyBindUp(GUIBoundKeyEventArgs args)
+    {
+        base.KeyBindUp(args);
+
+        if (args.Function != EngineKeyFunctions.UIClick)
+            return;
+
+        if (IsEditMode)
+        {
+            if (UserInterfaceManager.ControlFocused == this)
+                UserInterfaceManager.ControlFocused = null;
+
+            var wasDragged = _hasDragged;
+            _dragTouchOffset = null;
+            OnPositionChanged?.Invoke();
+
+            if (!wasDragged)
+            {
+                OnConfigureRequested?.Invoke(this);
+            }
+
+            args.Handle();
+            return;
+        }
+
+        if (_activeFingerId != null)
+        {
+            args.Handle();
+            return;
+        }
+
+        if (IsToggle)
+        {
+            args.Handle();
+            return;
+        }
+
+        if (!_isPressed)
+            return;
+
+        _isPressed = false;
+        ExecuteUp();
+        OnReleased?.Invoke();
+        args.Handle();
+    }
+
+    private void ExecuteDown()
+    {
+        if (SpecialAction == PojavSpecialAction.KeyboardToggle)
+        {
+            _keyboardActive = !_keyboardActive;
+            if (_keyboardActive)
+                _clyde.MainWindow?.TextInputStart();
+            else
+                _clyde.MainWindow?.TextInputStop();
+            return;
+        }
+
+        if (SpecialAction == PojavSpecialAction.Secondary)
+        {
+            MobileControlsOverlay.IsSecondaryActive = true;
+            return;
+        }
+
+        if (SpecialAction == PojavSpecialAction.Throw)
+        {
+            _inputManager.KeyDown(new KeyEventArgs(Keyboard.Key.Control, false, false, false, false, false, 0));
+            _inputManager.KeyDown(new KeyEventArgs(Keyboard.Key.Q, false, false, false, false, false, 0));
+            return;
+        }
+
+        if (ActionKey.HasValue)
+        {
+            _inputManager.KeyDown(new KeyEventArgs(ActionKey.Value, false, false, false, false, false, 0));
+        }
+    }
+
+    private void ExecuteUp()
+    {
+        if (SpecialAction == PojavSpecialAction.KeyboardToggle)
+            return;
+
+        if (SpecialAction == PojavSpecialAction.Secondary)
+        {
+            MobileControlsOverlay.IsSecondaryActive = false;
+            return;
+        }
+
+        if (SpecialAction == PojavSpecialAction.Throw)
+        {
+            _inputManager.KeyUp(new KeyEventArgs(Keyboard.Key.Q, false, false, false, false, false, 0));
+            _inputManager.KeyUp(new KeyEventArgs(Keyboard.Key.Control, false, false, false, false, false, 0));
+            return;
+        }
+
+        if (ActionKey.HasValue)
+        {
+            _inputManager.KeyUp(new KeyEventArgs(ActionKey.Value, false, false, false, false, false, 0));
+        }
+    }
+
+    protected internal override void Draw(DrawingHandleScreen handle)
+    {
+        base.Draw(handle);
+
+        var center = Size / 2f;
+        var radius = MathF.Min(Size.X, Size.Y) / 2f - 1.5f;
+        var active = _isPressed || IsToggled;
+
+        var bg = active
+            ? new Color(AccentColor.R, AccentColor.G, AccentColor.B, 0.78f)
+            : new Color(18, 22, 32, 0.72f);
+
+        var border = IsEditMode
+            ? new Color(255, 215, 0, 240)
+            : (active ? Color.White : new Color(AccentColor.R, AccentColor.G, AccentColor.B, 0.65f));
+
+        var drawRadius = active ? (radius - 1f) : radius;
+
+        handle.DrawCircle(center, drawRadius, bg, true);
+        handle.DrawCircle(center, drawRadius, border, false);
+
+        if (active)
+        {
+            handle.DrawCircle(center, drawRadius * 0.75f, new Color(255, 255, 255, 40), false);
+        }
+
+        if (IsToggle && IsToggled)
+        {
+            var badgePos = center + new Vector2(radius * 0.6f, -radius * 0.6f);
+            handle.DrawCircle(badgePos, 4f, Color.White, true);
+            handle.DrawCircle(badgePos, 2.5f, new Color(46, 204, 113), true);
+        }
+
+        if (IsEditMode)
+        {
+            var box = UIBox2.FromDimensions(Vector2.Zero, Size);
+            handle.DrawRect(box, new Color(255, 215, 0, 140), false);
+        }
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/VirtualThumbstick.cs b/Robust.Client/UserInterface/Mobile/VirtualThumbstick.cs
new file mode 100644
index 0000000..cf0d6ed
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/VirtualThumbstick.cs
@@ -0,0 +1,315 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using Robust.Client.Graphics;
+using Robust.Client.Input;
+using Robust.Client.UserInterface;
+using Robust.Shared.Input;
+using Robust.Shared.IoC;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+public sealed partial class VirtualThumbstick : Control
+{
+    [Dependency] private readonly IInputManager _inputManager = default!;
+
+    public float Radius { get; set; } = 75f;
+    public float KnobRadius { get; set; } = 32f;
+    public float Deadzone { get; set; } = 10f;
+
+    public Vector2 DefaultPosition { get; set; }
+    public Vector2? CustomPosition { get; set; }
+    public bool IsEditMode { get; set; }
+    public event Action? OnPositionChanged;
+    public event Action? OnStickSteering;
+
+    public bool IsPressed => _isPressed;
+
+    private bool _isPressed;
+    private Vector2 _knobOffset = Vector2.Zero;
+    private Vector2? _dragTouchOffset;
+    private readonly HashSet<Keyboard.Key> _activeKeys = new();
+
+    public VirtualThumbstick()
+    {
+        IoCManager.InjectDependencies(this);
+        MouseFilter = MouseFilterMode.Stop;
+        SetSize = new Vector2(Radius * 2f + 20f, Radius * 2f + 20f);
+    }
+
+    private long? _activeFingerId;
+
+    public void OnTouchDown(long fingerId, Vector2 localPos)
+    {
+        if (IsEditMode)
+            return;
+
+        _activeFingerId = fingerId;
+        _isPressed = true;
+        var offset = localPos - (Size / 2f);
+        UpdateStickOffset(offset);
+    }
+
+    public void OnTouchMove(long fingerId, Vector2 localPos)
+    {
+        if (IsEditMode || !_isPressed || _activeFingerId != fingerId)
+            return;
+
+        var offset = localPos - (Size / 2f);
+        UpdateStickOffset(offset);
+    }
+
+    public void OnTouchUp(long fingerId)
+    {
+        if (_activeFingerId == fingerId)
+        {
+            ReleaseStick();
+        }
+    }
+
+    public void ReleaseStick()
+    {
+        if (!_isPressed)
+            return;
+
+        _activeFingerId = null;
+        _isPressed = false;
+        _knobOffset = Vector2.Zero;
+        if (UserInterfaceManager.ControlFocused == this)
+            UserInterfaceManager.ControlFocused = null;
+        ReleaseAllKeys();
+    }
+
+    protected internal override bool HasPoint(Vector2 point)
+    {
+        var center = Size / 2f;
+        var distSq = (point - center).LengthSquared();
+        var touchRadius = Radius + 25f;
+        return distSq <= touchRadius * touchRadius;
+    }
+
+    protected internal override void ControlFocusExited()
+    {
+        base.ControlFocusExited();
+        if (IsEditMode)
+        {
+            _dragTouchOffset = null;
+        }
+    }
+
+    protected internal override void KeyBindDown(GUIBoundKeyEventArgs args)
+    {
+        base.KeyBindDown(args);
+
+        if (args.Function != EngineKeyFunctions.UIClick)
+            return;
+
+        if (IsEditMode)
+        {
+            UserInterfaceManager.ControlFocused = this;
+            _dragTouchOffset = args.RelativePosition;
+            args.Handle();
+            return;
+        }
+
+        if (_activeFingerId != null)
+        {
+            args.Handle();
+            return;
+        }
+
+        _isPressed = true;
+        var offset = args.RelativePosition - (Size / 2f);
+        UpdateStickOffset(offset);
+        args.Handle();
+    }
+
+    protected internal override void MouseMove(GUIMouseMoveEventArgs args)
+    {
+        base.MouseMove(args);
+
+        if (IsEditMode && _dragTouchOffset != null)
+        {
+            var parentGlobal = Parent?.GlobalPosition ?? Vector2.Zero;
+            var currentGlobal = GlobalPosition + args.RelativePosition;
+            var newGlobal = currentGlobal - _dragTouchOffset.Value;
+            var newLocal = newGlobal - parentGlobal;
+            CustomPosition = newLocal;
+            Arrange(new UIBox2(newLocal, newLocal + Size));
+            OnPositionChanged?.Invoke();
+            return;
+        }
+
+        if (_activeFingerId != null || !_isPressed || IsEditMode)
+            return;
+
+        var offset = args.RelativePosition - (Size / 2f);
+        UpdateStickOffset(offset);
+    }
+
+    protected internal override void KeyBindUp(GUIBoundKeyEventArgs args)
+    {
+        base.KeyBindUp(args);
+
+        if (args.Function != EngineKeyFunctions.UIClick)
+            return;
+
+        if (IsEditMode)
+        {
+            if (UserInterfaceManager.ControlFocused == this)
+                UserInterfaceManager.ControlFocused = null;
+
+            if (_dragTouchOffset != null)
+            {
+                _dragTouchOffset = null;
+                OnPositionChanged?.Invoke();
+            }
+            args.Handle();
+            return;
+        }
+
+        if (_activeFingerId != null)
+        {
+            args.Handle();
+            return;
+        }
+
+        if (!_isPressed)
+            return;
+
+        ReleaseStick();
+        args.Handle();
+    }
+
+    private void UpdateStickOffset(Vector2 rawOffset)
+    {
+        var dist = rawOffset.Length();
+        if (dist < 0.0001f)
+        {
+            _knobOffset = Vector2.Zero;
+            UpdateMovementKeys(Vector2.Zero, 0f);
+            return;
+        }
+
+        var dir = rawOffset / dist;
+        _knobOffset = dir * MathF.Min(dist, Radius);
+
+        if (dist >= Deadzone)
+        {
+            OnStickSteering?.Invoke();
+        }
+
+        UpdateMovementKeys(dir, dist);
+    }
+
+    private void UpdateMovementKeys(Vector2 dir, float dist)
+    {
+        var newKeys = new HashSet<Keyboard.Key>();
+
+        if (dist >= Deadzone)
+        {
+            const float threshold = 0.35f;
+
+            if (dir.Y < -threshold)
+                newKeys.Add(Keyboard.Key.W);
+            else if (dir.Y > threshold)
+                newKeys.Add(Keyboard.Key.S);
+
+            if (dir.X > threshold)
+                newKeys.Add(Keyboard.Key.D);
+            else if (dir.X < -threshold)
+                newKeys.Add(Keyboard.Key.A);
+        }
+
+        foreach (var key in _activeKeys)
+        {
+            if (!newKeys.Contains(key))
+            {
+                _inputManager.KeyUp(new KeyEventArgs(key, false, false, false, false, false, 0));
+            }
+        }
+
+        foreach (var key in newKeys)
+        {
+            if (!_activeKeys.Contains(key))
+            {
+                _inputManager.KeyDown(new KeyEventArgs(key, false, false, false, false, false, 0));
+            }
+        }
+
+        _activeKeys.Clear();
+        _activeKeys.UnionWith(newKeys);
+    }
+
+    private void ReleaseAllKeys()
+    {
+        foreach (var key in _activeKeys)
+        {
+            _inputManager.KeyUp(new KeyEventArgs(key, false, false, false, false, false, 0));
+        }
+        _activeKeys.Clear();
+    }
+
+    protected internal override void Draw(DrawingHandleScreen handle)
+    {
+        base.Draw(handle);
+
+        var center = Size / 2f;
+
+        handle.DrawCircle(center, Radius, new Color(15, 15, 15, 150), true);
+        var baseBorder = IsEditMode ? new Color(255, 215, 0, 240) : new Color(240, 240, 240, 200);
+        handle.DrawCircle(center, Radius, baseBorder, false);
+
+        handle.DrawCircle(center, Radius * 0.55f, new Color(255, 255, 255, 25), false);
+
+        var wActive = _activeKeys.Contains(Keyboard.Key.W);
+        var sActive = _activeKeys.Contains(Keyboard.Key.S);
+        var aActive = _activeKeys.Contains(Keyboard.Key.A);
+        var dActive = _activeKeys.Contains(Keyboard.Key.D);
+
+        var activeColor = new Color(255, 225, 60, 255);
+        var inactiveColor = new Color(255, 255, 255, 140);
+
+        var dotRadius = Radius - 10f;
+        handle.DrawCircle(center + new Vector2(0, -dotRadius), wActive ? 6.5f : 4f, wActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(0, dotRadius), sActive ? 6.5f : 4f, sActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(-dotRadius, 0), aActive ? 6.5f : 4f, aActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(dotRadius, 0), dActive ? 6.5f : 4f, dActive ? activeColor : inactiveColor, true);
+
+        var diagOffset = dotRadius * 0.7071f;
+        var wdActive = wActive && dActive;
+        var waActive = wActive && aActive;
+        var sdActive = sActive && dActive;
+        var saActive = sActive && aActive;
+
+        handle.DrawCircle(center + new Vector2(diagOffset, -diagOffset), wdActive ? 6.5f : 3f, wdActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(-diagOffset, -diagOffset), waActive ? 6.5f : 3f, waActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(diagOffset, diagOffset), sdActive ? 6.5f : 3f, sdActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(-diagOffset, diagOffset), saActive ? 6.5f : 3f, saActive ? activeColor : inactiveColor, true);
+
+        handle.DrawCircle(center, 5f, new Color(255, 255, 255, 90), true);
+
+        if (_isPressed && _knobOffset.LengthSquared() > 9f)
+        {
+            handle.DrawLine(center, center + _knobOffset, new Color(255, 255, 255, 140));
+        }
+
+        var knobCenter = center + _knobOffset;
+        var knobBg = _isPressed
+            ? new Color(255, 255, 255, 235)
+            : new Color(210, 210, 210, 185);
+
+        var knobBorder = Color.White;
+
+        handle.DrawCircle(knobCenter, KnobRadius, knobBg, true);
+        handle.DrawCircle(knobCenter, KnobRadius, knobBorder, false);
+        handle.DrawCircle(knobCenter, 6f, new Color(30, 30, 30, 220), true);
+
+        if (IsEditMode)
+        {
+            var box = UIBox2.FromDimensions(Vector2.Zero, Size);
+            handle.DrawRect(box, new Color(255, 215, 0, 150), false);
+        }
+    }
+}
