+    private async void SelectServer(ServerEntry server)
+    {
+        _selectedServer = server;
+        _detailNameLabel.Text = server.Name;
+        _detailPlayersLabel.Text = server.SoftMax > 0 ? $"Players: {server.Players} / {server.SoftMax}" : $"Players: {server.Players}";
+        _detailMapLabel.Text = $"Map: {server.Map ?? "Unknown"}  |  Mode: {server.Preset ?? "Unknown"}";
+        _detailAddressLabel.Text = $"Address: {server.Address}";
+        _detailConnectBtn.Disabled = false;
+        _detailLinksBox.RemoveAllChildren();
+        _detailDescLabel.SetMessage("Loading server details...");
+
+        try
+        {
+            var infoUrl = CleanAddressForHttp(server.Address) + "/info";
+            var infoJson = await _http.GetStringAsync(infoUrl);
+            var node = JsonNode.Parse(infoJson);
+            if (node == null) return;
+
+            var desc = node["desc"]?.GetValue<string>() ?? "No description provided.";
+            _detailDescLabel.SetMessage(desc);
+
+            if (node["links"] is JsonArray links)
+            {
+                foreach (var link in links)
+                {
+                    if (link == null) continue;
+                    var linkName = link["name"]?.GetValue<string>() ?? "Link";
+                    var linkUrl = link["url"]?.GetValue<string>();
+                    if (string.IsNullOrEmpty(linkUrl)) continue;
+
+                    var btn = new Button
+                    {
+                        Text = linkName,
+                        StyleClasses = { "ButtonSmall" }
+                    };
+                    btn.OnPressed += _ =>
+                    {
+                        if (Uri.TryCreate(linkUrl, UriKind.Absolute, out var uri))
+                            _uriOpener.OpenUri(uri);
+                    };
+                    _detailLinksBox.AddChild(btn);
+                }
+            }
+        }
+        catch
+        {
+            _detailDescLabel.SetMessage("Connected to server info endpoint unavailable or timed out.");
+        }
+    }
+
+    private static string CleanAddressForHttp(string address)
+    {
+        var addr = address.Trim();
+        if (addr.StartsWith("ss14s://", StringComparison.OrdinalIgnoreCase))
+            addr = "https://" + addr["ss14s://".Length..];
+        else if (addr.StartsWith("ss14://", StringComparison.OrdinalIgnoreCase))
+            addr = "http://" + addr["ss14://".Length..];
+        else if (!addr.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && !addr.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
+            addr = "http://" + addr;
+
+        return addr.TrimEnd('/');
+    }
