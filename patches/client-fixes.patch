--- /dev/null
+++ b/Content.Client/Launcher/ConnectServerCommand.cs
@@ -0,0 +1,42 @@
+using System;
+using Content.Client.MainMenu;
+using JetBrains.Annotations;
+using Robust.Client.UserInterface;
+using Robust.Shared.Console;
+using Robust.Shared.IoC;
+
+namespace Content.Client.Launcher;
+
+[UsedImplicitly]
+public sealed partial class ConnectServerCommand : IConsoleCommand
+{
+    [Dependency] private IUserInterfaceManager _ui = default!;
+
+    public string Command => "connectserver";
+    public string Description => "Connects directly to an SS14 server address";
+    public string Help => "connectserver <address>";
+
+    public void Execute(IConsoleShell shell, string argStr, string[] args)
+    {
+        if (args.Length == 0)
+        {
+            shell.WriteError("Address argument is required. Usage: connectserver <address>");
+            return;
+        }
+
+        var address = args[0].Trim('"', '\'');
+        shell.WriteLine($"Connecting to {address}...");
+
+        _ui.DeferAction(() =>
+        {
+            if (MainScreen.Instance != null)
+            {
+                MainScreen.Instance.ConnectTo(address);
+            }
+            else
+            {
+                shell.WriteError("MainScreen is not active, cannot connect.");
+            }
+        });
+    }
+}
