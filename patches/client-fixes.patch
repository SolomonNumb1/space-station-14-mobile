+using System;
+using System.IO;
+using System.Net.Http;
+using System.Reflection;
+using System.Security.Cryptography;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using System.Threading;
+using System.Threading.Tasks;
+using Robust.Shared.ContentPack;
+using Robust.Shared.IoC;
+using Robust.Shared.Log;
+using Robust.Shared.Utility;
+
+namespace Content.Client.Launcher;
+
+public sealed record ContentDownloadProgress(
+    long BytesDownloaded,
+    long TotalBytes,
+    double ProgressPercent,
+    double SpeedMegaBytesPerSec);
+
+public sealed record ServerBuildInfo(
+    string ForkId,
+    string Version,
+    string DownloadUrl,
+    string Hash);
+
+public sealed partial class ServerContentDownloader
+{
+    [Dependency] private IResourceManager _resManager = default!;
+    [Dependency] private ILogManager _logManager = default!;
+
+    private readonly HttpClient _http = new();
+    private ISawmill _sawmill = default!;
+
+    public ServerContentDownloader()
+    {
+        IoCManager.InjectDependencies(this);
+        _sawmill = _logManager.GetSawmill("content_dl");
+        _http.DefaultRequestHeaders.UserAgent.ParseAdd("SpaceStation14-Mobile-Launcher");
+        _http.Timeout = TimeSpan.FromMinutes(15);
+    }
+
+    public async Task<ServerBuildInfo?> FetchServerBuildInfoAsync(string address, CancellationToken cancel = default)
+    {
+        var cleanAddress = address.Trim();
+        var isSecure = cleanAddress.StartsWith("ss14s://", StringComparison.OrdinalIgnoreCase);
+        var stripped = cleanAddress;
+        if (isSecure)
+            stripped = cleanAddress[8..].TrimEnd('/');
+        else if (cleanAddress.StartsWith("ss14://", StringComparison.OrdinalIgnoreCase))
+            stripped = cleanAddress[7..].TrimEnd('/');
+        else if (cleanAddress.StartsWith("udp://", StringComparison.OrdinalIgnoreCase))
+            stripped = cleanAddress[6..].TrimEnd('/');
+
+        var urls = new List<string>();
+        if (isSecure)
+        {
+            urls.Add($"https://{stripped}/info");
+            urls.Add($"http://{stripped}/info");
+        }
+        else
+        {
+            urls.Add($"http://{stripped}/info");
+            urls.Add($"https://{stripped}/info");
+        }
+
+        foreach (var url in urls)
+        {
+            try
+            {
+                using var cts = CancellationTokenSource.CreateLinkedTokenSource(cancel);
+                cts.CancelAfter(TimeSpan.FromSeconds(6));
+
+                var res = await _http.GetStringAsync(url, cts.Token);
+                var node = JsonNode.Parse(res);
+                if (node == null)
+                    continue;
+
+                var buildNode = node["build"];
+                if (buildNode == null)
+                    continue;
+
+                var downloadUrl = buildNode["download_url"]?.GetValue<string>()
+                    ?? buildNode["manifest_download_url"]?.GetValue<string>();
+
+                var hash = buildNode["hash"]?.GetValue<string>()
+                    ?? buildNode["manifest_hash"]?.GetValue<string>()
+                    ?? "";
+
+                var forkId = buildNode["fork_id"]?.GetValue<string>() ?? "space-station-14";
+                var version = buildNode["version"]?.GetValue<string>() ?? "latest";
+
+                if (!string.IsNullOrEmpty(downloadUrl))
+                {
+                    return new ServerBuildInfo(forkId, version, downloadUrl, hash);
+                }
+            }
+            catch
+            {
+            }
+        }
+
+        return null;
+    }
+
+    public async Task<string?> DownloadAndMountContentAsync(
+        ServerBuildInfo build,
+        Action<ContentDownloadProgress>? progressCallback = null,
+        CancellationToken cancel = default)
+    {
+        try
+        {
+            var cacheDir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Space Station 14", "cache", "builds");
+            if (!Directory.Exists(cacheDir))
+            {
+                Directory.CreateDirectory(cacheDir);
+            }
+
+            var safeHash = string.IsNullOrEmpty(build.Hash)
+                ? $"{build.ForkId}_{build.Version}".Replace('/', '_').Replace('\\', '_')
+                : build.Hash.ToUpperInvariant();
+
+            var targetFile = Path.Combine(cacheDir, $"{safeHash}.zip");
+            var tempFile = Path.Combine(cacheDir, $"{safeHash}.tmp");
+
+            if (File.Exists(targetFile) && new FileInfo(targetFile).Length > 0)
+            {
+                _sawmill.Info($"Found cached content pack: {targetFile}");
+                progressCallback?.Invoke(new ContentDownloadProgress(100, 100, 100.0, 0.0));
+                MountContent(targetFile);
+                return targetFile;
+            }
+
+            _sawmill.Info($"Downloading content pack from {build.DownloadUrl} -> {targetFile}...");
+
+            using var response = await _http.GetAsync(build.DownloadUrl, HttpCompletionOption.ResponseHeadersRead, cancel);
+            response.EnsureSuccessStatusCode();
+
+            var totalBytes = response.Content.Headers.ContentLength ?? -1L;
+            await using var stream = await response.Content.ReadAsStreamAsync(cancel);
+            await using var fileStream = new FileStream(tempFile, FileMode.Create, FileAccess.Write, FileShare.None, 65536, true);
+
+            var buffer = new byte[65536];
+            long bytesDownloaded = 0;
+            var startTime = DateTime.UtcNow;
+            var lastReportTime = startTime;
+            using var sha = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
+
+            int read;
+            while ((read = await stream.ReadAsync(buffer.AsMemory(0, buffer.Length), cancel)) > 0)
+            {
+                await fileStream.WriteAsync(buffer.AsMemory(0, read), cancel);
+                sha.AppendData(buffer, 0, read);
+                bytesDownloaded += read;
+
+                var now = DateTime.UtcNow;
+                if ((now - lastReportTime).TotalMilliseconds >= 200)
+                {
+                    lastReportTime = now;
+                    var elapsedSec = (now - startTime).TotalSeconds;
+                    var mbPerSec = elapsedSec > 0 ? (bytesDownloaded / (1024.0 * 1024.0)) / elapsedSec : 0.0;
+                    var percent = totalBytes > 0 ? Math.Min(100.0, (bytesDownloaded * 100.0) / totalBytes) : 0.0;
+                    progressCallback?.Invoke(new ContentDownloadProgress(bytesDownloaded, totalBytes, percent, mbPerSec));
+                }
+            }
+
+            await fileStream.FlushAsync(cancel);
+            fileStream.Close();
+
+            if (!string.IsNullOrEmpty(build.Hash))
+            {
+                var hashBytes = sha.GetHashAndReset();
+                var calculatedHash = Convert.ToHexString(hashBytes).ToUpperInvariant();
+                if (!string.Equals(calculatedHash, build.Hash, StringComparison.OrdinalIgnoreCase))
+                {
+                    _sawmill.Warning($"Content pack hash mismatch! Expected {build.Hash}, got {calculatedHash}. File kept but flagged.");
+                }
+            }
+
+            if (File.Exists(targetFile))
+                File.Delete(targetFile);
+
+            File.Move(tempFile, targetFile);
+            _sawmill.Info($"Content pack successfully downloaded: {targetFile}");
+
+            progressCallback?.Invoke(new ContentDownloadProgress(bytesDownloaded, totalBytes, 100.0, 0.0));
+            MountContent(targetFile);
+            return targetFile;
+        }
+        catch (Exception ex)
+        {
+            _sawmill.Error($"Error downloading content pack: {ex}");
+            throw;
+        }
+    }
+
+    private void MountContent(string zipPath)
+    {
+        try
+        {
+            foreach (var m in _resManager.GetType().GetMethods(BindingFlags.Public | BindingFlags.Instance))
+            {
+                if (m.Name == "MountContentPack" && m.GetParameters().Length == 2 && m.GetParameters()[0].ParameterType == typeof(string))
+                {
+                    m.Invoke(_resManager, new object?[] { zipPath, null });
+                    _sawmill.Info($"Mounted content pack into VFS: {zipPath}");
+                    return;
+                }
+            }
+        }
+        catch (Exception ex)
+        {
+            _sawmill.Error($"Failed to mount content pack {zipPath}: {ex.Message}");
+        }
+    }
+}
