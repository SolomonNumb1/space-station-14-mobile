+using System;
+using System.Numerics;
+using Robust.Client.UserInterface;
+using Robust.Client.UserInterface.Controls;
+using Robust.Client.UserInterface.CustomControls;
+
+namespace Content.Client.Launcher;
+
+public sealed class ConnectingOverlay : DefaultWindow
+{
+    private readonly Label _serverNameLabel;
+    private readonly Label _statusLabel;
+    private readonly ProgressBar _progressBar;
+    private readonly Button _cancelButton;
+
+    public event Action? OnCancel;
+
+    public string ServerName => _serverNameLabel.Text ?? "";
+
+    public ConnectingOverlay()
+    {
+        Title = "Connecting";
+        MinSize = new Vector2(360, 200);
+
+        var vbox = new BoxContainer
+        {
+            Orientation = BoxContainer.LayoutOrientation.Vertical,
+            Margin = new Thickness(16),
+            SeparationOverride = 10,
+            HorizontalAlignment = HAlignment.Center
+        };
+        Contents.AddChild(vbox);
+
+        _serverNameLabel = new Label
+        {
+            Text = "Connecting to server...",
+            FontColorOverride = Color.FromHex("#ffd43b"),
+            HorizontalAlignment = HAlignment.Center
+        };
+        vbox.AddChild(_serverNameLabel);
+
+        _statusLabel = new Label
+        {
+            Text = "Initiating connection...",
+            FontColorOverride = Color.FromHex("#ced4da"),
+            HorizontalAlignment = HAlignment.Center
+        };
+        vbox.AddChild(_statusLabel);
+
+        _progressBar = new ProgressBar
+        {
+            MinValue = 0,
+            MaxValue = 100,
+            Value = 30,
+            MinWidth = 280,
+            MinHeight = 16
+        };
+        vbox.AddChild(_progressBar);
+
+        _cancelButton = new Button
+        {
+            Text = "Cancel",
+            HorizontalAlignment = HAlignment.Center,
+            MinWidth = 100,
+            Margin = new Thickness(0, 10, 0, 0)
+        };
+        _cancelButton.OnPressed += _ =>
+        {
+            OnCancel?.Invoke();
+            Close();
+        };
+        vbox.AddChild(_cancelButton);
+    }
+
+    public void UpdateStatus(string serverName, string status, float progress = -1f)
+    {
+        _serverNameLabel.Text = serverName;
+        _statusLabel.Text = status;
+        if (progress >= 0f)
+        {
+            _progressBar.Value = Math.Clamp(progress, 0f, 100f);
+        }
+    }
+}
