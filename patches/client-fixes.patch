+    public async void RefreshServers()
+    {
+        _serversStatusLabel.Visible = true;
+        _serversStatusLabel.Text = "Fetching servers from hub...";
+        _refreshBtn.Disabled = true;
+        _serverListVBox.RemoveAllChildren();
+        _allServers.Clear();
+
+        try
+        {
+            var json = await _http.GetStringAsync("https://hub.spacestation14.com/api/servers");
+            var array = JsonNode.Parse(json)?.AsArray();
+
+            if (array == null || array.Count == 0)
+            {
+                _serversStatusLabel.Text = "No servers received from hub.";
+                return;
+            }
+
+            foreach (var node in array)
+            {
+                if (node == null) continue;
+                var address = node["address"]?.GetValue<string>() ?? "";
+                var status = node["statusData"];
+                if (status == null) continue;
+
+                var name = status["name"]?.GetValue<string>() ?? "Unknown Server";
+                var players = status["players"]?.GetValue<int>() ?? 0;
+                var softMax = status["soft_max_players"]?.GetValue<int>() ?? 0;
+                var map = status["map"]?.GetValue<string>();
+                var preset = status["preset"]?.GetValue<string>();
+
+                var tagsList = new List<string>();
+                if (status["tags"] is JsonArray tagsArray)
+                {
+                    foreach (var t in tagsArray)
+                    {
+                        var tagStr = t?.GetValue<string>();
+                        if (!string.IsNullOrEmpty(tagStr))
+                            tagsList.Add(tagStr);
+                    }
+                }
+
+                _allServers.Add(new ServerEntry(name, address, players, softMax, map, preset, tagsList));
+            }
+
+            _allServers.Sort((a, b) => b.Players.CompareTo(a.Players));
+            _serversStatusLabel.Visible = false;
+            FilterServersList();
+
+            if (_allServers.Count > 0)
+                SelectServer(_allServers[0]);
+        }
+        catch (Exception ex)
+        {
+            _serversStatusLabel.Text = $"Error loading servers: {ex.Message}";
+        }
+        finally
+        {
+            _refreshBtn.Disabled = false;
+        }
+    }
+
+    private void FilterServersList()
+    {
+        _serverListVBox.RemoveAllChildren();
+
+        var query = _searchBar.Text.Trim().ToLowerInvariant();
+        var hideEmpty = _hideEmptyCheck.Pressed;
+        var hideFull = _hideFullCheck.Pressed;
+
+        var filtered = _allServers.Where(s =>
+        {
+            if (hideEmpty && s.Players == 0) return false;
+            if (hideFull && s.SoftMax > 0 && s.Players >= s.SoftMax) return false;
+            if (!string.IsNullOrEmpty(query))
+            {
+                var matchesName = s.Name.ToLowerInvariant().Contains(query);
+                var matchesMap = s.Map?.ToLowerInvariant().Contains(query) ?? false;
+                var matchesPreset = s.Preset?.ToLowerInvariant().Contains(query) ?? false;
+                var matchesTag = s.Tags.Any(t => t.ToLowerInvariant().Contains(query));
+                if (!matchesName && !matchesMap && !matchesPreset && !matchesTag)
+                    return false;
+            }
+            return true;
+        }).ToList();
+
+        if (filtered.Count == 0)
+        {
+            _serverListVBox.AddChild(new Label
+            {
+                Text = "No servers match current filter.",
+                HorizontalAlignment = HAlignment.Center,
+                Margin = new Thickness(0, 10, 0, 0)
+            });
+            return;
+        }
+
+        foreach (var server in filtered)
