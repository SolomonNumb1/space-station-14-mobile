+using System;
+using System.Numerics;
+using Robust.Client.UserInterface;
+using Robust.Client.UserInterface.Controls;
+using Robust.Client.UserInterface.CustomControls;
+
+namespace Content.Client.Launcher;
+
+public sealed class LauncherAccountWindow : DefaultWindow
+{
+    private readonly BoxContainer _contentContainer;
+    private readonly Label _statusLabel;
+
+    public LauncherAccountWindow()
+    {
+        Title = "Space Station 14 Account";
+        MinSize = new Vector2(380, 260);
+
+        _contentContainer = new BoxContainer
+        {
+            Orientation = BoxContainer.LayoutOrientation.Vertical,
+            Margin = new Thickness(12),
+            SeparationOverride = 8
+        };
+        Contents.AddChild(_contentContainer);
+
+        _statusLabel = new Label
+        {
+            FontColorOverride = Color.FromHex("#ff6b6b"),
+            HorizontalAlignment = HAlignment.Center,
+            Visible = false
+        };
+
+        UpdateView();
+        LauncherAuthManager.Instance.OnAuthChanged += UpdateView;
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        base.Dispose(disposing);
+        LauncherAuthManager.Instance.OnAuthChanged -= UpdateView;
+    }
+
+    private void UpdateView()
+    {
+        _contentContainer.RemoveAllChildren();
+        _statusLabel.Visible = false;
+
+        if (LauncherAuthManager.Instance.IsLoggedIn)
+        {
+            BuildLoggedInView();
+        }
+        else
+        {
+            BuildLoginFormView();
+        }
+
+        _contentContainer.AddChild(_statusLabel);
+    }
+
+    private void BuildLoggedInView()
+    {
+        var header = new Label
+        {
+            Text = "Account Status: Logged In",
+            FontColorOverride = Color.FromHex("#51cf66"),
+            HorizontalAlignment = HAlignment.Center
+        };
+        _contentContainer.AddChild(header);
+
+        var userLabel = new Label
+        {
+            Text = $"Username: {LauncherAuthManager.Instance.CurrentUsername}",
+            Margin = new Thickness(0, 10, 0, 4)
+        };
+        _contentContainer.AddChild(userLabel);
+
+        var idLabel = new Label
+        {
+            Text = $"User ID: {LauncherAuthManager.Instance.CurrentUserId}",
+            FontColorOverride = Color.FromHex("#aaaaaa"),
+            Margin = new Thickness(0, 0, 0, 16)
+        };
+        _contentContainer.AddChild(idLabel);
+
+        var logoutBtn = new Button
+        {
+            Text = "Log Out",
+            StyleClasses = { "negative" },
+            HorizontalAlignment = HAlignment.Center,
+            MinWidth = 140
+        };
+        logoutBtn.OnPressed += _ =>
+        {
+            LauncherAuthManager.Instance.LogOut();
+        };
+        _contentContainer.AddChild(logoutBtn);
+    }
+
+    private void BuildLoginFormView()
+    {
+        var info = new Label
+        {
+            Text = "Log in with your SS14 account to join protected servers.",
+            FontColorOverride = Color.FromHex("#cccccc"),
+            HorizontalAlignment = HAlignment.Center,
+            Margin = new Thickness(0, 0, 0, 8)
+        };
+        _contentContainer.AddChild(info);
+
+        var userLabel = new Label { Text = "Username or Email:" };
+        _contentContainer.AddChild(userLabel);
+
+        var usernameBox = new LineEdit
+        {
+            PlaceHolder = "Enter username or email...",
+            HorizontalExpand = true
+        };
+        _contentContainer.AddChild(usernameBox);
+
+        var passLabel = new Label { Text = "Password:" };
+        _contentContainer.AddChild(passLabel);
+
+        var passwordBox = new LineEdit
+        {
+            PlaceHolder = "Enter password...",
+            HorizontalExpand = true
+        };
+        _contentContainer.AddChild(passwordBox);
+
+        var buttonsRow = new BoxContainer
+        {
+            Orientation = BoxContainer.LayoutOrientation.Horizontal,
+            HorizontalAlignment = HAlignment.Center,
+            SeparationOverride = 12,
+            Margin = new Thickness(0, 10, 0, 0)
+        };
+
+        var loginBtn = new Button
+        {
+            Text = "Log In",
+            MinWidth = 110
+        };
+
+        loginBtn.OnPressed += async _ =>
+        {
+            loginBtn.Disabled = true;
+            _statusLabel.Text = "Logging in...";
+            _statusLabel.FontColorOverride = Color.FromHex("#ffdd57");
+            _statusLabel.Visible = true;
+
+            var (success, error) = await LauncherAuthManager.Instance.LogInAsync(usernameBox.Text, passwordBox.Text);
+            loginBtn.Disabled = false;
+
+            if (!success)
+            {
+                _statusLabel.Text = error ?? "Failed to log in.";
+                _statusLabel.FontColorOverride = Color.FromHex("#ff6b6b");
+                _statusLabel.Visible = true;
+            }
+            else
+            {
+                Close();
+            }
+        };
+
+        var guestBtn = new Button
+        {
+            Text = "Guest Mode",
+            MinWidth = 110
+        };
+        guestBtn.OnPressed += _ =>
+        {
+            LauncherAuthManager.Instance.LogOut();
+            Close();
+        };
+
+        buttonsRow.AddChild(loginBtn);
+        buttonsRow.AddChild(guestBtn);
+        _contentContainer.AddChild(buttonsRow);
+    }
+}
diff --git a/Content.Client/Launcher/LauncherAuthManager.cs b/Content.Client/Launcher/LauncherAuthManager.cs
new file mode 100644
index 0000000000..7f673fab60
--- /dev/null
+++ b/Content.Client/Launcher/LauncherAuthManager.cs
@@ -0,0 +1,177 @@
+using System;
+using System.IO;
+using System.Net.Http;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using System.Threading.Tasks;
+using Robust.Shared.IoC;
+using Robust.Shared.Network;
+
+namespace Content.Client.Launcher;
+
+public sealed class LauncherAuthManager
+{
+    private static readonly Lazy<LauncherAuthManager> LazyInstance = new(() => new LauncherAuthManager());
+    public static LauncherAuthManager Instance => LazyInstance.Value;
+
+    private readonly HttpClient _http = new() { Timeout = TimeSpan.FromSeconds(10) };
+
+    public string? CurrentUsername { get; private set; }
+    public Guid? CurrentUserId { get; private set; }
+    public string? CurrentToken { get; private set; }
+
+    public bool IsLoggedIn => !string.IsNullOrEmpty(CurrentToken);
+
+    public event Action? OnAuthChanged;
+
+    private LauncherAuthManager()
+    {
+        _http.DefaultRequestHeaders.UserAgent.ParseAdd("SpaceStation14-Launcher");
+    }
+
+    private static string GetAuthFilePath()
+    {
+        if (OperatingSystem.IsAndroid())
+        {
+            var dir = "/data/data/io.spacestation14.android/files";
+            if (!Directory.Exists(dir))
+                Directory.CreateDirectory(dir);
+            return Path.Combine(dir, "auth.json");
+        }
+
+        var appData = Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData);
+        var ss14Dir = Path.Combine(appData, "Space Station 14");
+        if (!Directory.Exists(ss14Dir))
+            Directory.CreateDirectory(ss14Dir);
+        return Path.Combine(ss14Dir, "auth.json");
+    }
+
+    public void LoadSavedAuth()
+    {
+        try
+        {
+            var path = GetAuthFilePath();
+            if (!File.Exists(path))
+                return;
+
+            var json = File.ReadAllText(path);
+            var node = JsonNode.Parse(json);
+            if (node == null)
+                return;
+
+            CurrentToken = node["token"]?.GetValue<string>();
+            CurrentUsername = node["username"]?.GetValue<string>();
+            if (Guid.TryParse(node["userId"]?.GetValue<string>(), out var guid))
+                CurrentUserId = guid;
+
+            ApplyToEngine();
+            OnAuthChanged?.Invoke();
+        }
+        catch (Exception ex)
+        {
+            Console.WriteLine($"[LauncherAuth] Failed to load saved auth: {ex.Message}");
+        }
+    }
+
+    private void ApplyToEngine()
+    {
+        if (IoCManager.Resolve<IAuthManager>() is { } authMan)
+        {
+            authMan.Token = CurrentToken;
+            if (CurrentUserId.HasValue)
+                authMan.UserId = new NetUserId(CurrentUserId.Value);
+            else
+                authMan.UserId = null;
+        }
+    }
+
+    public async Task<(bool Success, string? Error)> LogInAsync(string usernameOrEmail, string password)
+    {
+        if (string.IsNullOrWhiteSpace(usernameOrEmail) || string.IsNullOrWhiteSpace(password))
+            return (false, "Please enter both username and password.");
+
+        try
+        {
+            var body = new JsonObject
+            {
+                ["username"] = usernameOrEmail.Trim(),
+                ["password"] = password,
+                ["tfaCode"] = null
+            };
+
+            var content = new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json");
+            var response = await _http.PostAsync("https://auth.spacestation14.com/api/auth/authenticate", content);
+            var responseText = await response.Content.ReadAsStringAsync();
+
+            var json = JsonNode.Parse(responseText);
+            if (response.IsSuccessStatusCode && json != null)
+            {
+                CurrentToken = json["token"]?.GetValue<string>();
+                CurrentUsername = json["username"]?.GetValue<string>() ?? usernameOrEmail.Trim();
+                if (Guid.TryParse(json["userId"]?.GetValue<string>(), out var guid))
+                    CurrentUserId = guid;
+
+                SaveAuth();
+                ApplyToEngine();
+                OnAuthChanged?.Invoke();
+                return (true, null);
+            }
+
+            if (json?["errors"] is JsonArray arr && arr.Count > 0)
+            {
+                var sb = new StringBuilder();
+                foreach (var err in arr)
+                {
+                    if (sb.Length > 0) sb.Append("\n");
+                    sb.Append(err?.GetValue<string>());
+                }
+                return (false, sb.ToString());
+            }
+
+            return (false, $"Authentication failed (HTTP {(int)response.StatusCode})");
+        }
+        catch (Exception ex)
+        {
+            return (false, $"Network error: {ex.Message}");
+        }
+    }
+
+    public void LogOut()
+    {
+        CurrentToken = null;
+        CurrentUsername = null;
+        CurrentUserId = null;
+
+        try
+        {
+            var path = GetAuthFilePath();
+            if (File.Exists(path))
+                File.Delete(path);
+        }
+        catch {}
+
+        ApplyToEngine();
+        OnAuthChanged?.Invoke();
+    }
+
+    private void SaveAuth()
+    {
+        try
+        {
+            var obj = new JsonObject
+            {
+                ["token"] = CurrentToken,
+                ["username"] = CurrentUsername,
+                ["userId"] = CurrentUserId?.ToString()
+            };
+
+            var path = GetAuthFilePath();
+            File.WriteAllText(path, obj.ToJsonString(new JsonSerializerOptions { WriteIndented = true }));
+        }
+        catch (Exception ex)
+        {
+            Console.WriteLine($"[LauncherAuth] Failed to save auth: {ex.Message}");
+        }
+    }
+}
