+    }
+
+    protected override void ExitedTree()
+    {
+        if (Parent != null)
+            Parent.OnResized -= OnParentResized;
+        base.ExitedTree();
+    }
+
+    protected override void Opened()
+    {
+        base.Opened();
+        UpdateLayoutForParent();
+    }
+
+    private void OnParentResized() => UpdateLayoutForParent();
+
+    private void UpdateLayoutForParent()
+    {
+        if (Parent == null) return;
+        if (OperatingSystem.IsAndroid())
+        {
+            SetSize = Parent.Size;
+            LayoutContainer.SetPosition(this, Vector2.Zero);
+        }
+        else
+        {
+            SetSize = new Vector2(Math.Min(960, Math.Max(700, Parent.Size.X - 20)), Math.Min(640, Math.Max(460, Parent.Size.Y - 20)));
+            RecenterWindow(new Vector2(0.5f, 0.5f));
+        }
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        base.Dispose(disposing);
+        LauncherAuthManager.Instance.OnAuthChanged -= UpdateAccountButtonText;
+    }
+
+    private void UpdateAccountButtonText()
+    {
