+            try
+            {
+                using var client = new HttpClient();
+                client.Timeout = TimeSpan.FromSeconds(10);
+                var json = await client.GetStringAsync("https://hub.spacestation14.com/api/servers");
+
+                using var doc = JsonDocument.Parse(json);
+                _allServers.Clear();
+
+                foreach (var el in doc.RootElement.EnumerateArray())
+                {
+                    try
+                    {
+                        var address = el.GetProperty("address").GetString();
+                        if (string.IsNullOrEmpty(address))
+                            continue;
+
+                        var status = el.GetProperty("statusData");
+                        var name = status.GetProperty("name").GetString() ?? "Unknown Server";
+                        var players = status.TryGetProperty("players", out var p) ? p.GetInt32() : 0;
+                        var maxPlayers = status.TryGetProperty("soft_max_players", out var mp) ? mp.GetInt32() : 0;
+                        var map = status.TryGetProperty("map", out var m) ? m.GetString() : null;
+
+                        _allServers.Add(new ServerInfo(name, address, players, maxPlayers, map));
+                    }
+                    catch {}
+                }
+
+                _allServers.Sort((a, b) => b.Players.CompareTo(a.Players));
+                _statusLabel.Visible = false;
+                RebuildList();
+            }
+            catch (Exception ex)
+            {
+                _statusLabel.Visible = true;
+                _statusLabel.Text = $"Failed to load servers: {ex.Message}";
+            }
+            finally
+            {
+                _refreshButton.Disabled = false;
+            }
+        }
+
+        private void RebuildList()
+        {
+            _serverListContainer.RemoveAllChildren();
+            var filter = _searchBar.Text.Trim();
+
+            var filtered = string.IsNullOrEmpty(filter)
+                ? _allServers
+                : _allServers.Where(s => s.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
+                                         s.Address.Contains(filter, StringComparison.OrdinalIgnoreCase));
+
+            var count = 0;
+            foreach (var server in filtered)
+            {
+                count++;
+                var panel = new PanelContainer
+                {
+                    HorizontalExpand = true,
+                    Margin = new Thickness(2)
+                };
+
+                var row = new BoxContainer
+                {
+                    Orientation = BoxContainer.LayoutOrientation.Horizontal,
+                    HorizontalExpand = true,
+                    SeparationOverride = 10,
+                    Margin = new Thickness(6)
+                };
+
+                var infoBox = new BoxContainer
+                {
+                    Orientation = BoxContainer.LayoutOrientation.Vertical,
+                    HorizontalExpand = true,
+                    SeparationOverride = 2
+                };
+
+                var titleLabel = new Label
+                {
+                    Text = server.Name,
+                    FontColorOverride = Color.White
+                };
+                infoBox.AddChild(titleLabel);
+
+                var subtitleText = $"{server.Address}";
+                if (!string.IsNullOrEmpty(server.Map))
+                    subtitleText += $" • Map: {server.Map}";
+
+                var addrLabel = new Label
+                {
+                    Text = subtitleText,
+                    FontColorOverride = Color.FromHex("#A0A0A0")
+                };
+                infoBox.AddChild(addrLabel);
+
+                var playerLabel = new Label
+                {
+                    Text = $"{server.Players}/{server.MaxPlayers}",
+                    FontColorOverride = server.Players > 0 ? Color.FromHex("#70FF70") : Color.FromHex("#888888"),
+                    VerticalAlignment = VAlignment.Center
+                };
+
+                var connectBtn = new Button
+                {
+                    Text = "Connect",
+                    VerticalAlignment = VAlignment.Center
+                };
+                var targetAddr = server.Address;
+                connectBtn.OnPressed += _ =>
+                {
+                    ServerSelected?.Invoke(targetAddr);
+                    Close();
+                };
+
+                row.AddChild(infoBox);
+                row.AddChild(playerLabel);
+                row.AddChild(connectBtn);
+
+                panel.AddChild(row);
+                _serverListContainer.AddChild(panel);
+            }
+
+            if (count == 0 && _allServers.Count > 0)
+            {
+                _serverListContainer.AddChild(new Label
+                {
+                    Text = "No servers matched your filter.",
+                    HorizontalAlignment = HAlignment.Center
+                });
+            }
+        }
+    }
+}
